{"id": "ma_lim_001", "topic": "数学分析/极限", "problem": "求极限 $\\lim_{x\\to 0} \\frac{\\sin 3x}{x}$。", "ground_truth_answer": "3", "ground_truth_chunks": ["数学分析_theorem_3.2.1"], "rubric": "使用重要极限 lim_{x->0} sin x / x = 1，或等价无穷小 sin u ~ u。答案应为 3，写在 \\boxed{}。"}
{"id": "ma_lim_002", "topic": "数学分析/极限", "problem": "求极限 $\\lim_{x\\to 0} \\frac{e^x - 1 - x}{x^2}$。", "ground_truth_answer": "1/2", "ground_truth_chunks": ["数学分析_definition_taylor", "数学分析_theorem_lhospital"], "rubric": "使用洛必达法则两次，或泰勒展开 e^x = 1 + x + x^2/2 + o(x^2)。最终答案 1/2。"}
{"id": "ma_int_001", "topic": "数学分析/定积分", "problem": "计算 $\\int_0^{\\pi/2} \\sin^2 x \\, dx$。", "ground_truth_answer": "pi/4", "ground_truth_chunks": ["数学分析_example_wallis", "数学分析_theorem_newton_leibniz"], "rubric": "用半角公式 sin^2 x = (1 - cos 2x)/2，或华里士公式（Wallis）。答案 π/4。"}
{"id": "ma_int_002", "topic": "数学分析/不定积分", "problem": "计算不定积分 $\\int x e^x \\, dx$。", "ground_truth_answer": "(x-1)*exp(x)", "ground_truth_chunks": ["数学分析_theorem_integration_by_parts"], "rubric": "使用分部积分 ∫u dv = uv - ∫v du，取 u = x, dv = e^x dx。答案 (x-1)e^x + C。"}
{"id": "ma_series_001", "topic": "数学分析/级数", "problem": "判别级数 $\\sum_{n=1}^{\\infty} \\frac{1}{n^2 + n}$ 的敛散性，若收敛求其和。", "ground_truth_answer": "1", "ground_truth_chunks": ["数学分析_definition_series_convergence", "数学分析_example_telescoping"], "rubric": "用裂项 1/(n^2+n) = 1/n - 1/(n+1)，部分和 S_N = 1 - 1/(N+1) → 1。和等于 1。"}
{"id": "ma_multi_001", "topic": "数学分析/多元微积分", "problem": "设 $f(x, y) = x^2 + 2xy + 3y^2$，求 $\\frac{\\partial f}{\\partial x}$ 和 $\\frac{\\partial f}{\\partial y}$。", "ground_truth_answer": "2*x + 2*y, 2*x + 6*y", "ground_truth_chunks": ["数学分析_definition_partial"], "rubric": "偏导定义：固定其他变量对一个变量求导。∂f/∂x = 2x + 2y, ∂f/∂y = 2x + 6y。"}
{"id": "la_det_001", "topic": "高等代数/行列式", "problem": "计算行列式 $\\begin{vmatrix} 1 & 2 & 3 \\\\ 0 & 4 & 5 \\\\ 0 & 0 & 6 \\end{vmatrix}$。", "ground_truth_answer": "24", "ground_truth_chunks": ["高等代数_theorem_triangular_det"], "rubric": "上三角行列式等于对角元乘积：1*4*6 = 24。"}
{"id": "la_linsys_001", "topic": "高等代数/线性方程组", "problem": "解线性方程组 $\\begin{cases} x + 2y = 5 \\\\ 3x - y = 1 \\end{cases}$。", "ground_truth_answer": "x=1, y=2", "ground_truth_chunks": ["高等代数_theorem_cramer"], "rubric": "克莱姆法则或消元法。答案 x=1, y=2。"}
{"id": "la_eigen_001", "topic": "高等代数/特征值", "problem": "求矩阵 $A = \\begin{pmatrix} 2 & 1 \\\\ 1 & 2 \\end{pmatrix}$ 的全部特征值。", "ground_truth_answer": "1, 3", "ground_truth_chunks": ["高等代数_definition_eigenvalue", "高等代数_example_2x2_eigen"], "rubric": "解特征方程 det(A - λI) = (2-λ)^2 - 1 = 0，得 λ = 1 或 λ = 3。"}
{"id": "la_quad_001", "topic": "高等代数/二次型", "problem": "判断二次型 $f(x_1, x_2) = x_1^2 + 4 x_1 x_2 + 5 x_2^2$ 是否正定。", "ground_truth_answer": "正定", "ground_truth_chunks": ["高等代数_theorem_sylvester"], "rubric": "矩阵 A = [[1,2],[2,5]]。顺序主子式 1 > 0, det = 1*5 - 4 = 1 > 0。由 Sylvester 判据，正定。"}
